	)
	(text "Coplanar differential USB pairs (JLCPCB, 2 Layers JLC0216)\n   - Dieletric=4.5\n   - H=1.465\n   - eps=0.02\n\nJLCPCB coplanar     (W=0.32mm, S=0.15mm, g=0.2mm)\nuSimmics coplanar   (W=0.34mm, S=0.15mm, g=0.2mm) --> Zodd=44.91ohms\n\nUSB HS rise time is close to 5mm and this board is using FS is close to 1 meter !\nSo via stitching is not relevant."
		(exclude_from_sim no)
		(at 21.971 100.584 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e22219d0-83d0-42a3-9652-c9d44b55ca00")
	)
	(text "\"data\" and \"clk\" are 3.3V logic.\n"
		(exclude_from_sim no)
		(at 168.783 237.744 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify bottom)
		)
		(uuid "e459ba03-457b-4f6d-be50-ad5a8218a83b")
	)
	(text "Joysticks like JP19 can be mapped directly to keyboard matrix.\n(optional) Diodes are on modules."
		(exclude_from_sim no)
		(at 168.529 218.948 0)
		(effects
