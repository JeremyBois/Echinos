	(text "Resistors must be close to RP2040"
		(exclude_from_sim no)
		(at 171.45 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right bottom)
		)
		(uuid "fcbfc930-2a27-41d1-bc3d-99ab6840e699")
	)
	(text_box "--- SPI ---\nMISO = Wire between Slave-Out (TX) and Master-In  (RX)\nMOSI = Wire between Master-Out (TX) and Slave-In  (RX)\nSCLK = Master clock (SCK)\nCS   = Chip / device selector (CSn) "
		(exclude_from_sim no)
		(at 15.875 43.18 0)
		(size 87.63 13.97)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3979f285-a917-4bbe-b46f-71c08edfc6a5")
	)
	(text_box "--- RP2040 clock ---\nhttps://datasheets.raspberrypi.com/rp2040/rp2040-datasheet.pdf\n  - XIN can used as a single-ended CMOS clock input with XOUT disconnected\n  - The USB bootloader requires a 12MHz crystal or 12MHz clock input"
		(exclude_from_sim no)
		(at 15.875 12.7 0)
		(size 87.63 12.843)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a27c418e-467f-40df-bd5a-5b471b2ddb44")
	)
	(text_box "--- USART Half-duplex (QMK) ---\nhttps://github.com/qmk/qmk_firmware/blob/master/docs/serial_driver.md\n  - Faster than bitbang driver (default)but requires a pin supporting TX\n  - Internal pull-up drive the line high (no need to add external pull-up)\n  - Using PIO driver any pin can be used as TX or RX pins"
		(exclude_from_sim no)
		(at 15.875 26.67 0)
		(size 87.63 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d5c493af-7113-4d56-a858-59552c93075d")
	)
