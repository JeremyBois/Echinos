	(text "?? Add resistor (500ohm) at the  begining and the end to control impedance ??"
		(exclude_from_sim no)
		(at 106.68 84.074 0)
		(effects
			(font
				(size 2.54 2.54)
				(color 255 59 26 1)
			)
		)
		(uuid "0249fd7b-bdef-4e52-b596-af4e96f693ba")
	)
	(text "SK6812 is a clone of WS2812B speaking the same protocol\nHowever SK6812 seems to:\n - use a higher frequency --> less flickering at low brightness\n - be more reliable\n - be faster"
		(exclude_from_sim no)
		(at 82.804 81.534 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
			(href "https://hackaday.com/2017/01/25/ws2812b-led-clones-work-better-than-originals/")
		)
		(uuid "a08caba3-4a58-45d8-a5c9-cb77263c57e5")
	)
	(text "Datasheet \nrecommends\none capacitor \nper LED ..."
		(exclude_from_sim no)
		(at 40.64 52.832 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a96897dd-d714-495f-b5a4-85736a01ce85")
	)
	(text "Using option (1)\n\n(1) Use 5V for data and power with a level shifter (74HCT or TXB010 families)\n  - (-) 5V and 3.3V lines all over the board\n  - (+) Respect LED specifications on both data and power\n\n(2) Use 3.3V for data and power and first led close to MCU\n  - (+) 3.3V lines only on the board\n  - (-) Power is outside LED specifications\n  - (-) First LED should be as close as possible to the MCU pin to avoid a voltage drop on the data line because we are already outside of LED specifications"
		(exclude_from_sim no)
		(at 24.892 107.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "be6dfd09-8963-4df4-9397-c3d3998fd968")
	)
	(text "Use thick wires"
		(exclude_from_sim no)
		(at 41.148 64.008 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d03c8a17-e3bb-4619-b573-729041715c98")
	)
